PORT=4000

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sice
# Pon "true" si usas Aiven u otro proveedor que exija conexión cifrada
DB_SSL=false

# Cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto

# Zona horaria de la escuela (las horas de entrada y salida se calculan con ella)
TZ=America/Mexico_City

# Segundos que dura un código QR si nadie lo usa (60 por defecto)
QR_VIGENCIA_SEG=60

# OPCIONAL: HTTPS directo. La cámara del celular solo funciona en sitios HTTPS.
# (Si usas un túnel o un hosting con HTTPS, déjalo vacío.)
# SSL_KEY_PATH=./certs/key.pem
# SSL_CERT_PATH=./certs/cert.pem

# Correo para la RECUPERACIÓN DE CONTRASEÑA (código de 6 dígitos).
# Sin SMTP_HOST el correo no sale: el código solo se imprime en la consola del servidor (útil para pruebas).
# Ejemplo con Gmail (usa una "contraseña de aplicación"): SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="SICAJ - Secundaria Técnica 9 <correo@tudominio.com>"
